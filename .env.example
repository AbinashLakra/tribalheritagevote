# ==============================================================================
# Tribal Heritage Vote — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# Public: Canonical URL of the deployed platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public: Supabase project API URL (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public: Supabase anonymous/public key (from Project Settings → API → anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SECRET: Supabase service role key — server-side only, never expose to browser
# (from Project Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Cloudflare R2 (Video & Media Storage) ────────────────────────────────────
# SECRET: Cloudflare Account ID (from Cloudflare dashboard)
R2_ACCOUNT_ID=your-cloudflare-account-id

# SECRET: R2 S3-compatible Access Key ID (from R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id

# SECRET: R2 S3-compatible Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Configuration: R2 bucket name
R2_BUCKET_NAME=tribal-heritage-videos

# Public: Custom domain for public media delivery (CDN)
NEXT_PUBLIC_R2_MEDIA_DOMAIN=https://media.yourdomain.com

# ── Anti-Bot Protection (Cloudflare Turnstile) ───────────────────────────────
# Public: Turnstile widget site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# SECRET: Turnstile server-side validation secret
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Cron / Scheduled Jobs ────────────────────────────────────────────────────
# SECRET: Secret token to authenticate scheduled cron endpoint calls
CRON_SECRET=your-random-cron-secret

# ── Timezone ─────────────────────────────────────────────────────────────────
# Default timezone for all date/time operations
DEFAULT_TIMEZONE=Asia/Kolkata

