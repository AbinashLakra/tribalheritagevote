# ==============================================================================
# Tribal Heritage Vote — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# Public: Canonical URL of the deployed platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public: Supabase project API URL (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public: Supabase anonymous/public key (from Project Settings → API → anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SECRET: Supabase service role key — server-side only, never expose to browser
# (from Project Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Cloudflare R2 (Video & Media Storage) ────────────────────────────────────
# SECRET: Cloudflare Account ID (from Cloudflare dashboard)
R2_ACCOUNT_ID=your-cloudflare-account-id

# SECRET: R2 S3-compatible Access Key ID (from R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id

# SECRET: R2 S3-compatible Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Configuration: R2 bucket name
R2_BUCKET_NAME=tribal-heritage-videos

# Public: Custom domain for public media delivery (CDN)
NEXT_PUBLIC_R2_MEDIA_DOMAIN=https://media.yourdomain.com

# ── Anti-Bot Protection (Cloudflare Turnstile) ───────────────────────────────
# Public: Turnstile widget site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# SECRET: Turnstile server-side validation secret
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Cron / Scheduled Jobs ────────────────────────────────────────────────────
# SECRET: Secret token to authenticate scheduled cron endpoint calls
CRON_SECRET=your-random-cron-secret

# ── Timezone ─────────────────────────────────────────────────────────────────
# Default timezone for all date/time operations
DEFAULT_TIMEZONE=Asia/Kolkata

# ── Admin Console & Session Security ──────────────────────────────────────────
# Constant Master Password for Main Super Admin Login
SUPER_ADMIN_PASSWORD=BirsaMunda@2026
# HMAC-SHA256 Signing Secret for Admin Session Cookies and OTP hashing
ADMIN_SESSION_SECRET=adivasi_tribal_admin_session_key_2026

# ── Indian SMS OTP Gateway Providers (Optional / Plug-and-Play) ───────────────
# Option 0 (Recommended — No DLT needed, ~₹0.25-₹0.30/SMS): MessageCentral VerifyNow
# MESSAGECENTRAL_CUSTOMER_ID=your-messagecentral-customer-id
# MESSAGECENTRAL_PASSWORD=your-messagecentral-account-password
# MESSAGECENTRAL_EMAIL=your-messagecentral-email
# MESSAGECENTRAL_AUTH_TOKEN=optional-static-auth-token
# FAST2SMS_DISABLE_QUICK_SMS=true

# Option A: Fast2SMS (India Quick SMS ₹7/SMS without DLT / ₹0.25 with DLT)
FAST2SMS_API_KEY=your-fast2sms-api-key

# Option B: Twilio SMS (Global & India)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Option C: 2Factor.in (Indian SMS specialist — 2factor.in)
# TWOFACTOR_API_KEY=your-2factor-api-key

# Sandbox Mode: If no SMS key is provided above, the system generates random
# 6-digit cryptographic OTPs and displays the preview code for instant zero-cost testing.


